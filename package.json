{
  "name": "@guru-irl/spider",
  "version": "0.1.0",
  "license": "MIT",
  "description": "spider \u2014 all-in-one pi coding-agent extension (memory, context, todos, subagents, skills) on one shared SQLite database.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "spider"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "volta": {
    "node": "26.4.0"
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ],
    "skills": [
      "./packages/superpowers/skills"
    ]
  },
  "files": [
    "dist",
    "scripts/postinstall.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && node scripts/assert-bundle.mjs",
    "prepare": "npm run build",
    "bundle": "vite build",
    "dev": "vite build --watch",
    "dev:link": "node scripts/dev-link.mjs",
    "dev:unlink": "node scripts/dev-link.mjs --unlink",
    "link": "node scripts/link.mjs",
    "unlink": "node scripts/link.mjs --unlink",
    "typecheck": "tsgo -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/postinstall.mjs",
    "sync:models": "node scripts/sync-copilot-models.mjs"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "onnxruntime-node": "^1.29.0",
    "adm-zip": "^0.6.0",
    "protobufjs": "^7.6.6",
    "brace-expansion": "^5.0.9",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "undici": "^8.10.0",
    "tar": "^7.5.22",
    "fastembed": {
      "tar": "6.2.1"
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "fastembed": "^2.1.0",
    "sqlite-vec": "^0.1.6",
    "turndown": "^7.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0",
    "@earendil-works/pi-tui": ">=0.80.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.80.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.11",
    "@typescript/native-preview": "^7.0.0-dev.20260702.3",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^5.7.0",
    "vite": "^8.1.3",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guru-irl/spider.git"
  },
  "bugs": {
    "url": "https://github.com/guru-irl/spider/issues"
  },
  "homepage": "https://github.com/guru-irl/spider#readme"
}
