{
  "name": "@guru-irl/spider",
  "version": "0.0.0",
  "description": "spider — all-in-one pi coding-agent extension (memory, context, todos, subagents, skills) on one shared SQLite database.",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "spider"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ],
    "skills": [
      "./packages/superpowers/skills"
    ]
  },
  "files": [
    "dist",
    "scripts/postinstall.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && node scripts/assert-bundle.mjs",
    "bundle": "vite build",
    "dev": "vite build --watch",
    "dev:link": "node scripts/dev-link.mjs",
    "dev:unlink": "node scripts/dev-link.mjs --unlink",
    "typecheck": "tsgo -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/postinstall.mjs",
    "sync:models": "node scripts/sync-copilot-models.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "fastembed": "^1.14.1",
    "sqlite-vec": "^0.1.6",
    "turndown": "^7.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0",
    "@earendil-works/pi-tui": ">=0.80.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.2",
    "@earendil-works/pi-tui": "^0.80.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.11",
    "@typescript/native-preview": "^7.0.0-dev.20260702.3",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^5.7.0",
    "vite": "^8.1.3",
    "vitest": "^4.0.18"
  }
}
