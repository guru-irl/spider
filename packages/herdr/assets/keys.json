{
  "global": {
    "cmd-p": "mod.open:spider-picker",
    "cmd-n": {
      "command": "space.new",
      "args": {
        "machine": ""
      }
    },
    "cmd-t": "mod.open:spider-machine-picker",
    "cmd-d": "mod.open:spider-machine-picker-right",
    "cmd-shift-d": "mod.open:spider-machine-picker-down"
  },
  "layout:Spider": {
    "cmd-shift-e": "spider-pane.park",
    "cmd-shift-w": "spider-pane.close"
  },
  "terminal": {
    "cmd-shift-a": "send:\u001b[97;6u",
    "cmd-shift-o": "send:\u001b[111;6u",
    "cmd-shift-u": "send:\u001b[117;6u",
    "cmd-shift-m": "send:\u001b[109;6u",
    "cmd-shift-k": "send:\u001b[107;6u"
  }
}
