#!/usr/bin/env bash
# Resolve the workspace for one plan. Preserve the old flat ledger for its
# original plan; never silently overwrite or delete another plan's progress.
# Usage: sdd-workspace PLAN_FILE
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: sdd-workspace PLAN_FILE" >&2
  exit 2
fi
plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
slug=$(basename "$plan" .md)
[ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
  || { echo "cannot derive a workspace name from: $plan" >&2; exit 2; }
root=$(git rev-parse --show-toplevel)
base="$root/.superpowers/sdd"
plan_dir=$(CDPATH= cd -- "$(dirname "$plan")" && pwd -P)
plan_abs="$plan_dir/$(basename "$plan")"
case "$plan_abs" in
  "$root"/*) plan_id=${plan_abs#"$root"/} ;;
  *) plan_id=$plan_abs ;;
esac

# A ledger without an identity line is legacy, not a mismatch. If an identity
# exists, it is authoritative, even when a plan-path marker says otherwise.
ledger_matches() {
  [ -f "$1/progress.md" ] || return 0
  IFS= read -r first < "$1/progress.md" || :
  case "$first" in
    '# SDD ledger — plan: '*)
      ledger_plan=${first#'# SDD ledger — plan: '}
      [ "$ledger_plan" = "$plan_id" ] || [ "$ledger_plan" = "$plan_abs" ] ;;
    *) return 0 ;;
  esac
}

# The old flat workspace has no plan identity. Claim it for the first plan
# that encounters it, without modifying its progress.md. A second plan must
# stop and ask which plan owns the old ledger rather than assume it is safe.
if [ -f "$base/progress.md" ]; then
  if [ -f "$base/plan-path" ] && [ "$(< "$base/plan-path")" != "$plan_id" ]; then
    echo "legacy ledger belongs to another plan; resolve its ownership before continuing: $base/progress.md" >&2
    exit 2
  fi
  if ! ledger_matches "$base"; then
    echo "legacy ledger identifies another plan: $base/progress.md" >&2
    exit 2
  fi
  printf '%s\n' "$plan_id" > "$base/plan-path"
  printf '*\n' > "$base/.gitignore"
  CDPATH= cd -- "$base" && pwd
  exit 0
fi

owns() {
  if [ -f "$1/plan-path" ] && [ "$(< "$1/plan-path")" != "$plan_id" ]; then return 1; fi
  if ! ledger_matches "$1"; then
    # A matching marker with a mismatched ledger is corrupt, not an available
    # slot to skip. The controller needs to inspect it before continuing.
    if [ -f "$1/plan-path" ]; then
      echo "workspace ledger identifies a different plan: $1/progress.md" >&2
      exit 2
    fi
    return 1
  fi
  mkdir -p "$1"
  printf '%s\n' "$plan_id" > "$1/plan-path"
}

dir="$base/$slug"
if ! owns "$dir"; then
  parent=$(basename "$plan_dir")
  dir="$base/$slug-$parent"
  if ! owns "$dir"; then
    n=2
    while ! owns "$base/$slug-$parent-$n"; do n=$((n + 1)); done
    dir="$base/$slug-$parent-$n"
  fi
fi
printf '*\n' > "$base/.gitignore"
CDPATH= cd -- "$dir" && pwd
