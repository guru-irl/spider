{
  "version": 1,
  "rules": [
    {
      "id": "toolchain",
      "inputs": [
        "package.json",
        "package-lock.json",
        "packages/*/package.json",
        ".npmrc",
        ".nvmrc",
        ".node-version",
        ".tool-versions",
        "tsconfig*.json",
        "**/tsconfig*.json",
        "vite*.config.*",
        "vitest*.ts",
        "vitest*.mjs",
        ".github/**",
        "**/vite*.config.*",
        "**/vitest*.config.*",
        "**/vitest.setup.*",
        "**/vitest.herdr-global-setup.*"
      ],
      "tests": [],
      "related": [],
      "reason": "Resolution, setup and workflow changes can affect every test.",
      "full": true
    },
    {
      "id": "test-policy",
      "inputs": [
        "scripts/select-tests*",
        "scripts/test-resources.json",
        "scripts/run-selected-tests.mjs",
        "scripts/replay-test-selection.mjs",
        "scripts/vitest-*",
        "scripts/test-shards.ts",
        "scripts/list-test-shards.mjs",
        "scripts/test-shard-budget.mjs",
        "scripts/test-durations.json",
        "scripts/update-test-durations.mjs",
        "scripts/test-bundle.ts",
        "scripts/check-test-selection.mjs",
        "scripts/measure-test-selection.mjs"
      ],
      "tests": [],
      "related": [],
      "reason": "Selection and partition policy must not omit its own regressions.",
      "full": true
    },
    {
      "id": "build-install",
      "inputs": [
        "scripts/build*",
        "scripts/postinstall*",
        "scripts/*link*",
        "scripts/assert-bundle*",
        "scripts/check-package*",
        "scripts/package-extension.ts",
        "scripts/extension-shim.mjs",
        "scripts/generate-roam-sql.mjs"
      ],
      "tests": [],
      "related": [],
      "reason": "Build and package boundaries affect filesystem and subprocess consumers.",
      "full": true
    },
    {
      "id": "shared-environment",
      "inputs": [
        "packages/db-core/src/testutil.ts",
        "packages/db-core/src/__tests__/global-config.testutil.ts",
        "packages/herdr/src/__tests__/testutil.ts"
      ],
      "tests": [],
      "related": [],
      "reason": "Shared state and globally injected fixtures have suite-wide reach.",
      "full": true
    },
    {
      "id": "herdr-assets",
      "inputs": [
        "packages/herdr/assets/**",
        "scripts/spaces-*-fragments/**",
        "scripts/compose-spaces-*.mjs"
      ],
      "tests": [
        "packages/herdr/src/**/*.test.ts",
        "packages/host/src/**/herdr*.test.ts",
        "packages/host/src/herdr/**/*.test.ts",
        "packages/host/src/__tests__/*packag*.test.ts",
        "packages/host/src/__tests__/licence-notices.test.ts",
        "packages/herdr/src/__tests__/packaging.test.ts",
        "packages/superpowers/src/__tests__/packaging.test.ts"
      ],
      "related": [
        "packages/host/src/herdr/ports.ts"
      ],
      "reason": "Asset recipes, role templates and composed patches are read from disk."
    },
    {
      "id": "skills",
      "inputs": [
        "packages/*/skills/**"
      ],
      "tests": [
        "packages/$package/src/**/*.test.ts",
        "packages/host/src/__tests__/doctor-skills.test.ts",
        "packages/host/src/__tests__/*packag*.test.ts",
        "packages/host/src/__tests__/licence-notices.test.ts",
        "packages/herdr/src/__tests__/packaging.test.ts",
        "packages/superpowers/src/__tests__/packaging.test.ts",
        "packages/organism/src/__tests__/bundled-skills.test.ts"
      ],
      "related": [],
      "reason": "Skill guards walk Markdown and execute scripts; the organism inventories all shipped collections."
    },
    {
      "id": "documentation",
      "inputs": [
        "docs/**",
        "README.md",
        "packages/*/README.md",
        "assets/**"
      ],
      "tests": [
        "packages/host/src/__tests__/pi-config-examples.test.ts",
        "packages/host/src/__tests__/readme.test.ts",
        "packages/host/src/__tests__/config-reader-guard.test.ts",
        "packages/herdr/src/__tests__/herdr-documentation.test.ts",
        "packages/db-core/src/__tests__/roam-capture.test.ts",
        "packages/$package/src/**/*.test.ts"
      ],
      "related": [],
      "reason": "Example, README, configuration and roaming guards read document text."
    },
    {
      "id": "fixtures",
      "inputs": [
        "packages/*/src/**/fixtures/**"
      ],
      "tests": [
        "packages/$package/src/**/*.test.ts",
        "packages/herdr/src/**/*.test.ts",
        "packages/host/src/**/herdr*.test.ts",
        "packages/host/src/herdr/**/*.test.ts",
        "packages/host/src/__tests__/*packag*.test.ts",
        "packages/host/src/__tests__/licence-notices.test.ts",
        "packages/herdr/src/__tests__/packaging.test.ts",
        "packages/superpowers/src/__tests__/packaging.test.ts"
      ],
      "related": [],
      "reason": "Fixture paths are computed by helpers, including cross-package Herdr readers."
    },
    {
      "id": "intercom-policy",
      "inputs": [
        "packages/intercom/DIVERGENCE.json",
        "packages/intercom/upstream-assertions.json",
        "packages/intercom/ORIGIN.md",
        "packages/intercom/src/**"
      ],
      "tests": [
        "packages/intercom/src/__tests__/upstream-parity.test.ts",
        "packages/host/src/__tests__/intercom-upstream-inventory.test.ts"
      ],
      "related": [],
      "reason": "Parity scans source and metadata rather than importing them."
    },
    {
      "id": "source-text",
      "inputs": [
        "packages/*/src/**/*.ts",
        "packages/*/src/**/*.tsx",
        "packages/*/src/**/*.js",
        "packages/*/src/**/*.mjs"
      ],
      "tests": [
        "packages/host/src/__tests__/config-reader-guard.test.ts"
      ],
      "related": [],
      "reason": "The source-text configuration guard parses production files from disk."
    },
    {
      "id": "legacy-widget",
      "inputs": [
        "packages/subagents/src/index.ts"
      ],
      "tests": [
        "packages/host/src/__tests__/no-legacy-widget.test.ts"
      ],
      "related": [],
      "reason": "The legacy-widget guard reads the subagent entry as text."
    },
    {
      "id": "test-inventory",
      "inputs": [
        "packages/*/src/**/*.test.ts"
      ],
      "tests": [
        "packages/host/src/__tests__/test-shards.test.ts",
        "packages/host/src/__tests__/intercom-upstream-inventory.test.ts",
        "packages/host/src/__tests__/select-tests.test.ts"
      ],
      "related": [],
      "reason": "Full-inventory guards must see additions and changes to test files."
    },
    {
      "id": "parity-script",
      "inputs": [
        "scripts/check-intercom-parity.mjs"
      ],
      "tests": [
        "packages/intercom/src/__tests__/upstream-parity.test.ts"
      ],
      "related": [],
      "reason": "Parity imports this verifier through a computed file URL."
    },
    {
      "id": "build-probes",
      "inputs": [
        "scripts/probe-reload.mjs",
        "scripts/probe-build-watch.mjs"
      ],
      "tests": [
        "packages/host/src/__tests__/build-probes.test.ts"
      ],
      "related": [],
      "reason": "Probe guards read and launch these scripts."
    },
    {
      "id": "dashboard-output",
      "inputs": [
        "packages/host/src/usage/web/**"
      ],
      "tests": [
        "packages/host/src/usage/**/*.test.ts",
        "packages/host/src/__tests__/licence-notices.test.ts"
      ],
      "related": [],
      "reason": "The dashboard HTML entries emit ignored JavaScript and CSS consumed by packaging and browser guards."
    }
  ],
  "bundles": {
    "entries": [
      "packages/host/src/extension.ts",
      "packages/roam/src/cli-entry.ts",
      "packages/host/src/roam/cli-main.ts",
      "packages/roam/src/intercom-helper.ts",
